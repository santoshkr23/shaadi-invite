# Copy to /opt/shaadi/.env on the server and edit.
PUBLIC_URL=https://yourdomain.com
ADMIN_PASSWORD=change-this-long-password
# Your WhatsApp number with country code, digits only (also editable in Admin > Settings)
OWNER_WHATSAPP=919876543210
# Optional: Razorpay online payments. Leave empty to use UPI + manual confirmation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional tuning
PORT=8010
VIDEO_WORKERS=1
CHROME_PATH=/usr/bin/google-chrome
